/* Renames the vendored CORE-MATH entry point to the libm symbol name via
 * #define + #include, rather than a wrapper function that calls it: this
 * keeps the implementation in a single translation unit (no cross-TU call
 * for a hot path) and leaves no cr_<name> symbol in the final binary.
 *
 * Generated by options/ansi/core-math/meson.build from this template for
 * every vendored function; do not edit the generated file directly. */
#include <math.h>

#define @CR_NAME@ @LIBM_NAME@
#include "@VENDOR_FILE@"
@EXTRA@